   "tags": [
    "句式模板",
    "反差"
   ]
  },
  {
   "id": "x-is-x",
   "re": "[\\u4e00-\\u9fa5]{2,4}是[\\u4e00-\\u9fa5]{2,4}的[\\u4e00-\\u9fa5]{1,4}",
