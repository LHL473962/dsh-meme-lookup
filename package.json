{
  "name": "dsh-meme-lookup",
  "version": "1.4.1",
  "description": "梗插件：查梗、看懂梗、判断能不能用、接梗、抛梗，附带设置页",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "*.json",
    "emotes",
    "tools",
    "tests",
    "README.md",
    "TESTING.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "meme"
  ],
  "license": "MIT"
}
