{
  "name": "dsh-meme-lookup",
  "version": "1.4.31",
  "description": "梗插件：查梗、看懂梗、判断能不能用、接梗、抛梗，附带设置页",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "*.json",
    "emotes",
    "tools",
    "tests",
    "README.md",
    "TESTING.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.2",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0",
      "dshReleases": {
        "0.2.0-rc.1": "compatible",
        "0.2.1-rc.1": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "meme"
  ],
  "license": "MIT",
  "capabilityRedLines": [
    "不主动发帖、不评论、不私信（贴吧/B站一律只读）",
    "不采集、不存储用户名与主页（只留句子）",
    "不上传任何本地文件到第三方",
    "不把用户词表写进公开仓库（meme-user-lexicon 只在本机）"
  ]
}
